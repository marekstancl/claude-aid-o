# svc-mcp-tg-bot environment template (P032 Step 6).
# Copy to /opt/eco/services/.env (or merge if file exists) and fill in.
# DO NOT commit the populated /opt/eco/services/.env file — it holds secrets.

# Bot token from BotFather:
#   https://t.me/BotFather  →  /newbot  (or reuse from existing bot)
TELEGRAM_ALERT_BOT_TOKEN=

# Default chat ID. For groups use numeric form including the leading minus
# (e.g. -1001234567890). For channels use "@channel_username". For DMs use
# the user's numeric ID. AID FSM repeated-fail alerts target this chat
# unless the caller passes an explicit chat_id.
TELEGRAM_ALERT_DEFAULT_CHAT_ID=

# Optional overrides (defaults shown):
# MCP_HTTP_PORT=8818
# MCP_HTTP_HOST=127.0.0.1   # bind to localhost only — see plan §S.2

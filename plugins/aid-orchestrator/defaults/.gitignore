# AID Orchestrator — runtime artifacts (not versioned)
# Design artifacts (plans, tasks, config) ARE versioned

# Runtime evidence and execution logs
.aid-o/work/evidence/
.aid-o/work/quick/
.aid-o/work/timeline.jsonl

# Runtime queue state
.aid-o/config/queue.yaml

# Interim brainstorming notes (temporary, deleted after plan completion)
.aid-o/work/interim-*.md

# Legacy v1 structure
.aid-o/04-engine/

# Per-plan execution worktrees (P074) — `plan-start` creates
# .aid-worktrees/plan-<id> as a linked git worktree on plan/<id> and
# plan-close/plan-rollback remove it. Deliberately top-level, NOT under
# .aid-o/: execution trees and AID state stay separated, so tearing a
# worktree down never touches plan state.
.aid-worktrees/

# UI fidelity runtime outputs (capture sessions, not fixture data)
.aid-o/work/**/ui/

# lib/ui-fidelity node_modules
lib/ui-fidelity/node_modules/

# Gate runtime baselines (P063) — local performance telemetry, not versioned.
# Already-initialized existing projects get this backfilled automatically
# into .git/info/exclude (see aid-gate-runtime-baseline.sh's
# gate_baseline_ensure_gitignored) — this entry only benefits brand-new
# projects created via /aid-init after this line shipped.
.aid-o/metrics/

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aid.local/plan.schema.json",
  "title": "AID Plan",
  "description": "Execution plan generated from an EPIC by the Planner. Defines steps, dependencies, parallel groups, and analysis groups for the Controller state machine.",
  "type": "object",
  "required": ["epic_id", "version", "steps", "dependencies"],
  "properties": {
    "epic_id": {
      "type": "string",
      "description": "Reference to the source EPIC identifier",
      "examples": ["AID-0001", "ERP-INV-01"]
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Plan version (incremented on re-planning)"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of plan creation"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered list of execution steps",
      "items": {
        "type": "object",
        "required": ["id", "role", "objective"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^step_[a-z0-9_]+$",
            "description": "Unique step identifier",
            "examples": ["step_1_architect", "step_2_domain"]
          },
          "role": {
            "type": "string",
            "enum": ["architect", "domain", "backend", "frontend", "qa", "security", "observability", "docs", "release"],
            "description": "Agent role to execute this step"
          },
          "objective": {
            "type": "string",
            "minLength": 10,
            "description": "What this step must accomplish"
          },
          "inputs": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Required inputs (from EPIC or previous step outputs)"
          },
          "outputs": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Expected outputs (files, artifacts, decisions)"
          },
          "constraints": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Step-specific constraints"
          },
          "allowed_paths": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Filesystem paths this step may modify"
          },
          "forbidden_paths": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Filesystem paths this step must NOT touch"
          },
          "acceptance_criteria": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Verifiable criteria that must be met for this step to pass acceptance validation. Each criterion should be specific and testable."
          }
        },
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "description": "Explicit ordering constraints between steps",
      "items": {
        "type": "object",
        "required": ["before", "after"],
        "properties": {
          "before": {
            "type": "string",
            "description": "Step ID that must complete first"
          },
          "after": {
            "type": "string",
            "description": "Step ID that depends on 'before'"
          },
          "reason": {
            "type": "string",
            "description": "Why this dependency exists"
          }
        },
        "additionalProperties": false
      }
    },
    "parallel_groups": {
      "type": "array",
      "description": "Groups of step IDs that can execute concurrently (different work in parallel)",
      "items": {
        "type": "array",
        "items": { "type": "string" },
        "minItems": 2
      }
    },
    "analysis_groups": {
      "type": "array",
      "description": "Multi-perspective analysis groups — multiple agents analyze the SAME target step from different perspectives. Unlike parallel_groups (different work), analysis_groups are read-only reviews of completed work.",
      "items": {
        "type": "object",
        "required": ["id", "target", "agents", "mode", "merge_strategy"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^analysis_[0-9]+_[a-z_]+$",
            "description": "Unique analysis group identifier",
            "examples": ["analysis_1_security_review", "analysis_2_db_validation"]
          },
          "target": {
            "type": "string",
            "pattern": "^step_[a-z0-9_]+$",
            "description": "Step ID being analyzed (must reference an existing step)"
          },
          "agents": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["architect", "domain", "backend", "frontend", "qa", "security", "observability", "docs", "release"]
            },
            "minItems": 1,
            "description": "Agent roles performing the analysis — must NOT include the target step's own agent role"
          },
          "mode": {
            "type": "string",
            "enum": ["review", "audit", "validation"],
            "description": "Analysis mode: review = findings list, audit = scoring (0-100), validation = pass/fail"
          },
          "merge_strategy": {
            "type": "string",
            "enum": ["union", "consensus", "weighted"],
            "description": "How to merge findings from multiple agents: union = all findings, consensus = 2+ agree, weighted = domain expertise weights"
          },
          "trigger": {
            "type": "string",
            "enum": ["auto", "manual"],
            "default": "auto",
            "description": "Whether this group was auto-generated by Planner rules or manually specified in EPIC"
          }
        },
        "additionalProperties": false
      }
    },
    "gates": {
      "type": "array",
      "description": "Quality gates to run after all steps complete",
      "items": {
        "type": "string",
        "enum": ["tests_pass", "lint_pass", "security_scan_pass", "docs_updated"]
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_llm_cost_usd": {
          "type": "number",
          "minimum": 0,
          "description": "Maximum LLM cost for this plan execution"
        },
        "max_retries_per_gate": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 3
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

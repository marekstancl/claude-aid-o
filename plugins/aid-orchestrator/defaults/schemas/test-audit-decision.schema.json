{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aid-orchestrator.aidlab.dev/schemas/test-audit-decision.schema.json",
  "title": "AID Test Portfolio Audit \u2014 Consolidated Decision Artifact",
  "$comment": "producer: aid-test-audit-consolidate.sh (via lib/aid-test-audit-decision.sh aid_test_audit_decision_write), consumers: [lib/aid-test-audit-chat-summary.sh, lib/aid-test-audit-write-plan-bridge.sh]. P072 Step 2. This is the CONSOLIDATED decision \u2014 a single global conclusion per audit. Per-unit terminal dispositions live in the wave artifacts (test-audit-wave-artifact.schema.json), not here.",
  "description": "Strict, public-safe decision artifact written once per full-mode audit. Human prose belongs in the rendered report and the evidence files, never in a durable protocol field here \u2014 every free-text field is length-bounded and rejects absolute paths.",
  "type": "object",
  "required": [
    "schema_version",
    "audit_id",
    "audit_status",
    "current_runtime",
    "actions",
    "parallelization",
    "unresolved",
    "portfolio_coverage",
    "portfolio_change"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "aid-test-audit-decision-v1"
    },
    "audit_id": {
      "$ref": "#/$defs/stable_id",
      "description": "The audit this decision belongs to. The write-plan bridge compares it with the durable record's audit_id, so a decision artifact left in a reused output directory by an EARLIER audit cannot authorize a later one."
    },
    "audit_status": {
      "enum": [
        "complete",
        "incomplete"
      ],
      "description": "`incomplete` blocks the --write-plan handoff (lib/aid-test-audit-write-plan-bridge.sh). It is NOT a failure \u2014 it is an honest refusal to be treated as remediation-ready."
    },
    "incomplete_reason": {
      "$ref": "#/$defs/controlled_reason",
      "description": "Required when audit_status is `incomplete`; forbidden when `complete`. Controlled vocabulary, never free text."
    },
    "current_runtime": {
      "type": "object",
      "required": [
        "kind",
        "duration_ms",
        "scope"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "measured",
            "lower_bound",
            "unknown"
          ]
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stable_id"
          },
          "description": "Named catalog/run-unit membership the duration covers. A duration with no stated membership is not a measurement."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "unknown"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "duration_ms": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "measured",
                  "lower_bound"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "duration_ms": {
                "type": "integer"
              }
            }
          }
        }
      ]
    },
    "actions": {
      "type": "array",
      "description": "May be empty \u2014 a genuinely healthy portfolio proposes nothing. An empty actions[] must never be conflated with audit_status: incomplete.",
      "items": {
        "type": "object",
        "required": [
          "action",
          "targets",
          "priority",
          "reason",
          "evidence_refs",
          "impact"
        ],
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "fix",
              "merge",
              "remove",
              "split",
              "parallelize",
              "keep_serial",
              "measure",
              "add",
              "strengthen",
              "rewire",
              "quarantine"
            ]
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/stable_id"
            }
          },
          "priority": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "reason": {
            "$ref": "#/$defs/bounded_text"
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/evidence_ref"
            }
          },
          "impact": {
            "$ref": "#/$defs/impact"
          },
          "proposal_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Stable fingerprint (sha256 of action+targets+change, first 16 hex). Without identity, every audit re-proposes the two hundred things the owner already declined, and a proposal cannot go stale when its file changes."
          },
          "change": {
            "type": [
              "string",
              "null"
            ],
            "description": "The concrete edit, naming file:line. Carried from the finding's proposal."
          },
          "effort": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "bucket"
                ],
                "properties": {
                  "bucket": {
                    "enum": [
                      "S",
                      "M",
                      "L",
                      "decision-required"
                    ],
                    "description": "S: single file, mechanical. M: multiple files or a new fixture/helper. L: test architecture, gate config, or production code. decision-required: a human must rule on intent (delete, merge, coverage adequacy)."
                  },
                  "verify_bucket": {
                    "enum": [
                      "S",
                      "M",
                      "L",
                      "decision-required"
                    ],
                    "description": "Effort to VERIFY the change did not lose anything \u2014 split from the edit itself, because most delete proposals are S to perform and L to verify, and the verification cost is what decides whether it is worth doing."
                  },
                  "repeat_count": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "How many sites the same mechanical change applies to. 'S x 14 sites' is more truthful than 'M'."
                  },
                  "facts": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "The countable facts that produced the bucket: files touched, production code changed y/n, new helper needed y/n."
                  }
                }
              },
              {
                "type": "null"
              }
            ],
            "description": "Counted-facts effort buckets; see the proposal contract."
          },
          "conflicts_with": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "proposal_ids this action contradicts. Both sides carry the reference; neither is silently dropped."
          },
          "declined_previously": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "True when this proposal_id appears in the project's declined ledger (.aid-o/config/test-audit-decisions.yaml). Kept in the artifact for honesty, hidden from the default render."
          }
        }
      }
    },
    "parallelization": {
      "type": "object",
      "required": [
        "lanes",
        "smallest_safe_pilot"
      ],
      "additionalProperties": false,
      "properties": {
        "lanes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "lane_id",
              "disposition",
              "run_unit_ids",
              "resource_basis",
              "evidence_refs"
            ],
            "additionalProperties": false,
            "properties": {
              "lane_id": {
                "$ref": "#/$defs/stable_id"
              },
              "disposition": {
                "enum": [
                  "proposed_parallel",
                  "keep_serial",
                  "blocked_pending_fix",
                  "context_required"
                ]
              },
              "run_unit_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/stable_id"
                },
                "description": "Disjointness ACROSS lanes is not expressible in JSON Schema; lib/aid-test-audit-decision.sh enforces it in bash and returns exit code 4 naming both lane ids."
              },
              "resource_basis": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/resource_pair"
                }
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidence_ref"
                }
              }
            },
            "allOf": [
              {
                "$comment": "A lane may only be proposed for parallel execution with at least one citable piece of evidence. keep_serial/context_required may legitimately carry none.",
                "if": {
                  "properties": {
                    "disposition": {
                      "const": "proposed_parallel"
                    }
                  },
                  "required": [
                    "disposition"
                  ]
                },
                "then": {
                  "properties": {
                    "evidence_refs": {
                      "minItems": 1
                    }
                  }
                }
              }
            ]
          }
        },
        "smallest_safe_pilot": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "run_unit_ids",
            "workers",
            "repeat",
            "pass_criteria"
          ],
          "additionalProperties": false,
          "description": "The smallest bounded pilot that would settle the most currently-unresolved units. Null only when nothing is unresolved.",
          "properties": {
            "run_unit_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/stable_id"
              }
            },
            "workers": {
              "type": "integer",
              "minimum": 2
            },
            "repeat": {
              "type": "integer",
              "minimum": 1
            },
            "pass_criteria": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/bounded_text"
              }
            }
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "run_unit_id",
          "missing_proof",
          "next_measurement"
        ],
        "additionalProperties": false,
        "properties": {
          "run_unit_id": {
            "$ref": "#/$defs/stable_id"
          },
          "missing_proof": {
            "$ref": "#/$defs/controlled_reason"
          },
          "next_measurement": {
            "$ref": "#/$defs/bounded_text",
            "description": "Must name a bounded operation this plugin can actually run \u2014 not an aspiration."
          }
        }
      }
    },
    "portfolio_coverage": {
      "type": "object",
      "required": [
        "inventory_count",
        "assigned_count",
        "disposition_count",
        "missing_run_unit_ids",
        "duplicate_run_unit_ids"
      ],
      "additionalProperties": false,
      "description": "Computed by the consolidator from the inventory, the dispatch manifest and the wave artifacts \u2014 never from a shard's self-reported count.",
      "properties": {
        "inventory_count": {
          "type": "integer",
          "minimum": 0
        },
        "assigned_count": {
          "type": "integer",
          "minimum": 0
        },
        "disposition_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_run_unit_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stable_id"
          }
        },
        "duplicate_run_unit_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stable_id"
          }
        }
      }
    },
    "portfolio_change": {
      "type": "object",
      "required": [
        "current_run_units",
        "proposed_run_units",
        "keep",
        "rewrite_unit",
        "merge_groups",
        "remove",
        "runtime_before_ms",
        "runtime_after_ms",
        "impact_kind"
      ],
      "additionalProperties": false,
      "properties": {
        "current_run_units": {
          "type": "integer",
          "minimum": 0
        },
        "proposed_run_units": {
          "type": "integer",
          "minimum": 0
        },
        "keep": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stable_id"
          }
        },
        "rewrite_unit": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stable_id"
          }
        },
        "merge_groups": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/$defs/stable_id"
            }
          },
          "description": "Connected components over the overlap relation. A group of one is not a merge."
        },
        "remove": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stable_id"
          }
        },
        "runtime_before_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "runtime_after_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "impact_kind": {
          "enum": [
            "measured",
            "estimated",
            "unknown"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "impact_kind": {
                "const": "unknown"
              }
            },
            "required": [
              "impact_kind"
            ]
          },
          "then": {
            "properties": {
              "runtime_before_ms": {
                "type": "null"
              },
              "runtime_after_ms": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "impact_kind": {
                "const": "measured"
              }
            },
            "required": [
              "impact_kind"
            ]
          },
          "then": {
            "properties": {
              "runtime_before_ms": {
                "type": "integer"
              },
              "runtime_after_ms": {
                "type": "integer"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "$comment": "A COMPLETE audit is one where every discovered unit reached exactly one terminal disposition. Missing or duplicate ids are precisely the conditions that make that false, so `complete` cannot coexist with either.",
      "if": {
        "properties": {
          "audit_status": {
            "const": "complete"
          }
        },
        "required": [
          "audit_status"
        ]
      },
      "then": {
        "properties": {
          "portfolio_coverage": {
            "properties": {
              "missing_run_unit_ids": {
                "maxItems": 0
              },
              "duplicate_run_unit_ids": {
                "maxItems": 0
              }
            }
          }
        },
        "not": {
          "required": [
            "incomplete_reason"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "audit_status": {
            "const": "incomplete"
          }
        },
        "required": [
          "audit_status"
        ]
      },
      "then": {
        "required": [
          "incomplete_reason"
        ]
      }
    }
  ],
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "$comment": "Matches the run_unit_id grammar (bats:path, sh:path, gate:name, npm:script) plus lane ids. Leading '/' is impossible, which is what keeps an absolute path out of an id field."
    },
    "bounded_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "$comment": "Bounded, public-safe reason text. What is ACTUALLY enforced: length 1-500, no embedded absolute path, and a NAMED set of credential shapes (AWS key id, GitHub/Slack tokens, PEM private-key header, an inline credential assignment with a 12+ character value). This is a deliberately narrow list, not general secret detection \u2014 claiming the latter would promise a guarantee no regex can keep. Human prose belongs in the rendered report and evidence files.",
      "allOf": [
        {
          "$comment": "Rejects an embedded absolute path. Human prose belongs in the rendered report and evidence files; this field carries a bounded, public-safe reason only.",
          "not": {
            "pattern": "(^|\\s)(/[A-Za-z0-9._-]+){2,}"
          }
        },
        {
          "$comment": "AWS access key id.",
          "not": {
            "pattern": "(AKIA|ASIA)[0-9A-Z]{16}"
          }
        },
        {
          "$comment": "GitHub personal access / app tokens.",
          "not": {
            "pattern": "(ghp|gho|ghs|ghu|ghr)_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}"
          }
        },
        {
          "$comment": "Slack tokens.",
          "not": {
            "pattern": "xox[abprs]-[A-Za-z0-9-]{10,}"
          }
        },
        {
          "$comment": "A PEM private-key header.",
          "not": {
            "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----"
          }
        },
        {
          "$comment": "An inline credential assignment with a substantial value: `api_key=\u2026`, `secret: \u2026`, `password=\u2026`, `token=\u2026`. Deliberately requires 12+ characters so a sentence like `the api_key is unset` is not rejected.",
          "not": {
            "pattern": "(?i)(api[_-]?key|secret|passwd|password|token)\\s*[:=]\\s*\\S{12,}"
          }
        }
      ]
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "$comment": "Audit-relative path or artifact id. Anchored to a non-'/' first character so an absolute path cannot be recorded; lib/aid-test-audit-decision.sh additionally rejects any ref containing '..'."
    },
    "resource_pair": {
      "type": "string",
      "pattern": "^(temp_path|fixed_path|working_dir|git_repo|git_worktree|aid_state|lock|port|socket|process_group|cache|external_service)/(per-test|per-run|shared|unknown)$",
      "$comment": "Controlled vocabulary from P072's resource-namespace design. The kind and its namespace are one fact, so `fixed_path/shared` and `temp_path/per-test` never blend into a single judgement."
    },
    "controlled_reason": {
      "enum": [
        "empty_inventory",
        "coverage_mismatch",
        "duplicate_dispositions",
        "unresolved_fraction_exceeded",
        "budget_exhausted",
        "interrupted",
        "no_resource_map",
        "no_pilot_evidence",
        "runner_capability_absent",
        "template_context_required",
        "source_unreadable"
      ],
      "$comment": "Controlled, not free text \u2014 a reason a consumer can branch on. Extending this list is a schema change, which is the point: a new reason must be a deliberate contract decision."
    },
    "impact": {
      "type": "object",
      "required": [
        "kind",
        "before_ms",
        "after_ms",
        "assumptions"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "measured",
            "estimated",
            "unknown"
          ]
        },
        "before_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "after_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bounded_text"
          }
        }
      },
      "allOf": [
        {
          "$comment": "measured means two comparable runs happened \u2014 both endpoints must be real numbers, and there is nothing left to assume.",
          "if": {
            "properties": {
              "kind": {
                "const": "measured"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "before_ms": {
                "type": "integer"
              },
              "after_ms": {
                "type": "integer"
              },
              "assumptions": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "$comment": "estimated is only honest when its assumptions are stated. An estimate with no stated assumptions is a guess wearing a number.",
          "if": {
            "properties": {
              "kind": {
                "const": "estimated"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "assumptions": {
                "minItems": 1
              }
            }
          }
        },
        {
          "$comment": "`unknown` claims no BENEFIT \u2014 which is what an absent `after_ms` says. A `before_ms` may still be recorded, because a current cost is not a claimed saving: with no after value there is no delta to imply. This is what lets an honest LOWER BOUND from an unfinished profile be reported at all; forbidding both numbers forced the alternative of dropping the only measurement the run actually produced. The assumptions rule follows from that same relaxation: when a number IS recorded it must be qualified, because a bare `before_ms` on an unfinished run reads as a measured total; when no number is recorded there is nothing to qualify and assumptions would be clutter.",
          "if": {
            "properties": {
              "kind": {
                "const": "unknown"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "before_ms": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "after_ms": {
                "type": "null"
              },
              "assumptions": {
                "type": "array"
              }
            },
            "allOf": [
              {
                "$comment": "a recorded cost must say what it is",
                "if": {
                  "properties": {
                    "before_ms": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "before_ms"
                  ]
                },
                "then": {
                  "properties": {
                    "assumptions": {
                      "minItems": 1
                    }
                  }
                },
                "else": {
                  "properties": {
                    "assumptions": {
                      "maxItems": 0
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}

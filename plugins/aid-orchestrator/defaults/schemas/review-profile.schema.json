{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aid-orchestrator.aidlab.dev/schemas/review-profile.schema.json",
  "title": "AID Protocol v2 — ReviewProfile",
  "$comment": "producer: C0/profile_resolver, consumers: [C1, C2, C3, C4]",
  "description": "Artifact emitted by the profile resolver (invoked from C0) specifying which review lenses are required for this run and a hash of the profile for freshness tracking.",
  "type": "object",
  "allOf": [
    {
      "$comment": "extends aid-protocol-v2.schema.json envelope (reference only — not a resolved $ref)"
    }
  ],
  "properties": {
    "artifact_type": {
      "const": "review_profile",
      "$comment": "enforced — must equal this type"
    },
    "review_profile": {
      "type": "object",
      "$comment": "enforced — minimal payload; full schema defined in owning phase",
      "properties": {
        "required_lenses": {
          "type": "array",
          "items": {"type": "string"}
        },
        "profile_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "matched_surfaces": {
          "type": "array",
          "items": {"type": "string"}
        },
        "plan_time_surfaces": {
          "type": "array",
          "items": {"type": "string"}
        },
        "candidate_time_surfaces": {
          "type": "array",
          "items": {"type": "string"}
        },
        "risk_profile": {
          "type": "string",
          "enum": ["docs_trivial", "low", "medium", "high", "unverifiable"]
        },
        "ir_cadence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "c2_authorities_max": {
          "type": "integer"
        },
        "llm_authorities_total_max": {
          "type": "integer"
        },
        "completed_lenses": {
          "type": "array",
          "items": { "type": "string" },
          "$comment": "populated by C2 from lenses_run[] aggregate; fallback to empty [] when C2 absent (E3 backward-compat)"
        }
      },
      "required": [
        "required_lenses",
        "profile_hash",
        "matched_surfaces",
        "plan_time_surfaces",
        "candidate_time_surfaces",
        "risk_profile",
        "ir_cadence",
        "c2_authorities_max",
        "llm_authorities_total_max"
      ]
    }
  },
  "required": ["review_profile"]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aid-orchestrator.aidlab.dev/schemas/ui-calibration-record.schema.json",
  "title": "AID UI Calibration Record",
  "description": "Evidence record produced by ui-calibration-run.sh. pm_signoff is filled manually by PM after reviewing evidence.",
  "type": "object",
  "required": ["calibration"],
  "additionalProperties": false,
  "properties": {
    "calibration": {
      "type": "object",
      "required": ["schema_version", "run_at", "cases", "result", "pm_signoff"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "type": "string", "const": "1.0.0" },
        "run_at": { "type": "string", "format": "date-time" },
        "cases": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": ["case_id", "description", "first_run", "first_run_reason", "rerun", "evidence_dir"],
            "additionalProperties": false,
            "properties": {
              "case_id": { "type": "string" },
              "description": { "type": "string" },
              "first_run": { "type": "string", "enum": ["pass", "fail", "error", "unverifiable"] },
              "first_run_reason": { "type": "string" },
              "rerun": { "type": "string", "enum": ["pass", "fail", "error", "unverifiable"] },
              "evidence_dir": { "type": "string" }
            }
          }
        },
        "result": { "type": "string", "enum": ["pass", "fail"] },
        "pm_signoff": {
          "type": "object",
          "required": ["confirmed_by", "confirmed_at", "notes"],
          "additionalProperties": false,
          "properties": {
            "confirmed_by": { "type": ["string", "null"] },
            "confirmed_at": { "type": ["string", "null"] },
            "notes": { "type": ["string", "null"] }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aid-orchestrator.aidlab.dev/schemas/plan-review-finding.schema.json",
  "title": "AID plan review — reviewer answer",
  "$comment": "producer: a plan reviewer (reviewer-<role>.json), consumers: aid-plan-review-round.sh collect, aid-plan-review-adjudicate.sh. collect enforces the answer shape and the adjudicator rejects each finding whose command or evidence breaks its pattern; both read the role enum and the two patterns from this file, so they have one source.",
  "description": "One reviewer's answer for one plan-review round. A finding without a read-only command and a path:line evidence does not exist.",
  "type": "object",
  "additionalProperties": false,
  "required": ["role", "findings"],
  "properties": {
    "role": {
      "enum": ["generalist_a", "generalist_b", "behaviour_edges", "feasibility_deps", "reuse", "enforcement_tests"]
    },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "no_findings_reason": { "type": "string", "minLength": 1 }
  },
  "if": { "properties": { "findings": { "maxItems": 0 } } },
  "then": { "required": ["no_findings_reason"] },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "step", "severity", "claim", "command", "evidence", "fix"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "step": { "type": ["integer", "null"] },
        "severity": { "enum": ["blocker", "major", "minor"] },
        "claim": { "type": "string", "minLength": 1 },
        "command": {
          "type": "string",
          "pattern": "^(grep|rg|ls|find|sed -n|git grep|wc|head|tail|bash [^;|&>]+ --help)( |$)"
        },
        "evidence": {
          "type": "string",
          "pattern": "^[^:;]+:[0-9]+(; *[^:;]+:[0-9]+)*$"
        },
        "fix": { "type": "string", "minLength": 1 }
      }
    }
  }
}

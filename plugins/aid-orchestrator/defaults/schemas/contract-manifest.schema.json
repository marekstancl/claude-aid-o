{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aid-orchestrator.aidlab.dev/schemas/contract-manifest.schema.json",
  "title": "AID Protocol v2 — ContractManifest",
  "$comment": "producer: C0, consumers: [C2, C3, C4]",
  "description": "Artifact emitted by C0 listing all inter-step contracts — producer/consumer pairs with pending consumption proof.",
  "type": "object",
  "allOf": [
    {
      "$comment": "extends aid-protocol-v2.schema.json envelope (reference only — not a resolved $ref)"
    }
  ],
  "properties": {
    "artifact_type": {
      "const": "contract_manifest"
    },
    "contract_manifest": {
      "type": "object",
      "$comment": "required: bindings, consumption_proof, manifest_hash",
      "properties": {
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "producer":   { "type": "string" },
              "consumer":   { "type": "string" },
              "field":      { "type": "string" },
              "status":     { "type": "string", "enum": ["pending", "unverifiable"] },
              "provenance": { "type": "string", "enum": ["plan_dependency", "explicit", "inferred"] },
              "hash":       { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            },
            "required": ["producer", "consumer", "field", "status", "provenance", "hash"]
          }
        },
        "consumption_proof": {
          "type": "object",
          "properties": {
            "state":               { "type": "string" },
            "authoritative_phase": { "type": "string" }
          },
          "required": ["state", "authoritative_phase"]
        },
        "manifest_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": ["bindings", "consumption_proof", "manifest_hash"]
    }
  },
  "required": ["contract_manifest"]
}

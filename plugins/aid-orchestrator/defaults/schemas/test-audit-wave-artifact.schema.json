{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aid-orchestrator.aidlab.dev/schemas/test-audit-wave-artifact.schema.json",
  "title": "AID Test Portfolio Audit \u2014 Per-Wave Agent Artifact",
  "$comment": "producer: controller (one file per dispatched shard/specialist agent, per aid-test-audit-dispatch.sh's manifest), consumers: [aid-test-audit-consolidate.sh, aid-test-audit-state.sh advance_wave validation]",
  "description": "Raw output of one wave-1/2/3 agent, written to .aid-o/work/test-audits/<audit-id>/agents/<wave>-<focus>[-<shard_id>].json before consolidation. advance_wave halts rather than silently advancing if a wave artifact fails this schema.",
  "type": "object",
  "required": [
    "schema_version",
    "focus",
    "wave",
    "shard_id",
    "findings",
    "produced_at",
    "producer_agent_dispatch_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "focus": {
      "type": "string",
      "enum": [
        "shard_portfolio",
        "performance_cost",
        "flake_isolation",
        "adversarial_review",
        "consolidator"
      ]
    },
    "wave": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "shard_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Only shard_portfolio-focus artifacts are sharded; null for all other focuses."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "run_unit_id",
          "category",
          "severity",
          "evidence_refs",
          "recommendation",
          "confidence",
          "falsification_check"
        ],
        "properties": {
          "run_unit_id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "description": "At least one. The consolidated-findings schema has always required minItems 1 here, and this one did not, so an agent could hand in an artifact that passed its own validation and then killed consolidation with an internal error naming neither the finding nor the field. It happened for real \u2014 three findings from one shard. The producer is now held to the strictest consumer's rule, which is where a contract mismatch has to be resolved: a finding with no evidence is not a finding."
          },
          "recommendation": {
            "type": "string",
            "enum": [
              "keep",
              "fix",
              "split",
              "merge",
              "remove",
              "quarantine",
              "measure",
              "add",
              "strengthen",
              "rewire"
            ],
            "description": "`add`: a missing test should exist (uncovered error path \u2014 benefit is risk, not seconds). `strengthen`: the test exercises real code but its oracle is too weak to fail; fix the assertion, do not delete. `rewire`: a gate/catalog configuration change (duplicate execution across overlapping gates, a unit no gate runs, a timeout below real runtime)."
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "falsification_check": {
            "type": "string"
          },
          "proposal": {
            "description": "A concrete remediation proposal. Not a label \u2014 the change names the file:line and the exact edit, the benefit says how it was obtained (and 'unknown' is a normal answer), and the effort is counted facts, never invented hours. Analysts that cannot fill these honestly must omit the proposal rather than decorate a guess.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "change",
              "effort",
              "benefit"
            ],
            "properties": {
              "change": {
                "type": "string",
                "minLength": 1,
                "description": "The exact edit, naming file:line \u2014 'test-aid-fsm.bats:359 writes $TEST_PROJECT_ROOT/.aid-o under a fixed path; allocate a per-test temp dir instead'. Never 'improve isolation'."
              },
              "effort": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "bucket"
                ],
                "properties": {
                  "bucket": {
                    "enum": [
                      "S",
                      "M",
                      "L",
                      "decision-required"
                    ],
                    "description": "S: single file, mechanical. M: multiple files or a new fixture/helper. L: test architecture, gate config, or production code. decision-required: a human must rule on intent (delete, merge, coverage adequacy)."
                  },
                  "verify_bucket": {
                    "enum": [
                      "S",
                      "M",
                      "L",
                      "decision-required"
                    ],
                    "description": "Effort to VERIFY the change did not lose anything \u2014 split from the edit itself, because most delete proposals are S to perform and L to verify, and the verification cost is what decides whether it is worth doing."
                  },
                  "repeat_count": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "How many sites the same mechanical change applies to. 'S x 14 sites' is more truthful than 'M'."
                  },
                  "facts": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "The countable facts that produced the bucket: files touched, production code changed y/n, new helper needed y/n."
                  }
                }
              },
              "benefit": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "measured",
                      "extrapolated",
                      "estimated",
                      "unknown"
                    ],
                    "description": "measured: from this run's own timings/pilot. extrapolated: measured on a sample and scaled \u2014 name both. estimated: from a stated model. unknown: emit no number at all. An audit that never says unknown is not measuring."
                  },
                  "critical_path_ms": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Seconds saved on the CRITICAL PATH, not summed CPU \u2014 saving 30s beside a 5-minute serial test saves nothing. Null unless kind supports a number."
                  },
                  "risk_note": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "What newly goes undetected (for remove/merge) or newly becomes detected (for add/strengthen). The only unit available where time is not the point."
                  },
                  "assumptions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "conflicts_with": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "finding_ids/proposal_ids this proposal contradicts \u2014 'share the setup' contradicts 'isolate per test'. Emit the conflict; never both sides as independent advice."
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer_agent_dispatch_id": {
      "type": "string",
      "minLength": 1
    },
    "dispositions": {
      "type": "array",
      "description": "P072 Step 4 \u2014 exactly one TERMINAL disposition per run_unit_id this shard was assigned, including when the answer is `keep`. Silence cannot distinguish 'healthy and uniquely useful' from 'never inspected', so a shard that inspected nothing must say `measure` with a named missing_proof rather than emitting no record. Presence is enforced by aid-test-audit-consolidate.sh --mode full, not by this schema: the schema has no view of the audit mode, and a static/measure audit legitimately produces no dispositions. What this schema guarantees is that a disposition, WHEN present, is complete.",
      "items": {
        "type": "object",
        "required": [
          "run_unit_id",
          "disposition",
          "behavior_claim",
          "failure_signal",
          "falsification",
          "uniqueness",
          "layer",
          "cheaper_layer_possible",
          "cost",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "run_unit_id": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "keep",
              "fix",
              "rewrite_unit",
              "merge",
              "split",
              "remove",
              "quarantine",
              "measure"
            ]
          },
          "behavior_claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "The invariant or historical regression this unit claims to protect."
          },
          "failure_signal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "The concrete signal the test emits when that behavior breaks."
          },
          "falsification": {
            "type": "object",
            "required": [
              "method"
            ],
            "additionalProperties": false,
            "properties": {
              "method": {
                "enum": [
                  "mutation",
                  "revert",
                  "input_probe",
                  "unproved"
                ]
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
                "description": "Audit-relative path. Anchored to a non-'/' first character so an absolute path cannot be recorded; the consolidator additionally resolves it and refuses anything that escapes the audit directory."
              }
            },
            "allOf": [
              {
                "$comment": "Anything other than `unproved` is a claim that a check was actually run, so it must cite where.",
                "if": {
                  "properties": {
                    "method": {
                      "enum": [
                        "mutation",
                        "revert",
                        "input_probe"
                      ]
                    }
                  },
                  "required": [
                    "method"
                  ]
                },
                "then": {
                  "required": [
                    "evidence_ref"
                  ]
                }
              }
            ]
          },
          "uniqueness": {
            "enum": [
              "unique",
              "overlaps",
              "unproved"
            ]
          },
          "overlaps_with": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "layer": {
            "enum": [
              "unit",
              "contract",
              "integration",
              "e2e"
            ]
          },
          "cheaper_layer_possible": {
            "enum": [
              "yes",
              "no",
              "unproved"
            ]
          },
          "target_layer": {
            "enum": [
              "unit",
              "contract",
              "integration",
              "e2e"
            ]
          },
          "cost": {
            "type": "object",
            "required": [
              "kind",
              "duration_ms"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "measured",
                  "lower_bound",
                  "unknown"
                ]
              },
              "duration_ms": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "unknown"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "properties": {
                    "duration_ms": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "measured",
                        "lower_bound"
                      ]
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "properties": {
                    "duration_ms": {
                      "type": "integer"
                    }
                  }
                }
              }
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "missing_proof": {
            "enum": [
              "empty_inventory",
              "coverage_mismatch",
              "duplicate_dispositions",
              "unresolved_fraction_exceeded",
              "budget_exhausted",
              "interrupted",
              "no_resource_map",
              "no_pilot_evidence",
              "runner_capability_absent",
              "template_context_required",
              "source_unreadable"
            ],
            "description": "Required when disposition is `measure` \u2014 a controlled reason, never free text."
          },
          "next_measurement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Required when disposition is `measure` \u2014 names a bounded operation this plugin can actually run."
          }
        },
        "allOf": [
          {
            "$comment": "A coverage-REDUCING proposal must name which retained test still catches the defect. `unproved` is not an argument for deletion.",
            "if": {
              "properties": {
                "disposition": {
                  "enum": [
                    "remove",
                    "merge",
                    "rewrite_unit"
                  ]
                }
              },
              "required": [
                "disposition"
              ]
            },
            "then": {
              "properties": {
                "falsification": {
                  "properties": {
                    "method": {
                      "enum": [
                        "mutation",
                        "revert",
                        "input_probe"
                      ]
                    }
                  },
                  "required": [
                    "evidence_ref"
                  ]
                }
              }
            }
          },
          {
            "$comment": "Claiming overlap without naming the peer is not a claim a reader can check.",
            "if": {
              "properties": {
                "uniqueness": {
                  "const": "overlaps"
                }
              },
              "required": [
                "uniqueness"
              ]
            },
            "then": {
              "required": [
                "overlaps_with"
              ],
              "properties": {
                "overlaps_with": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "$comment": "'a cheaper layer would do' is only actionable when it names which layer.",
            "if": {
              "properties": {
                "cheaper_layer_possible": {
                  "const": "yes"
                }
              },
              "required": [
                "cheaper_layer_possible"
              ]
            },
            "then": {
              "required": [
                "target_layer"
              ]
            }
          },
          {
            "$comment": "`measure` is the honest 'I did not settle this' answer, but it must say what is missing and what would settle it.",
            "if": {
              "properties": {
                "disposition": {
                  "const": "measure"
                }
              },
              "required": [
                "disposition"
              ]
            },
            "then": {
              "required": [
                "missing_proof",
                "next_measurement"
              ]
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "Pre-P072 rule, restored: only shard_portfolio artifacts are sharded. P072 Step 4 overwrote this key when adding the dispositions requirement and then removed it entirely, silently dropping the shard_id/focus binding \u2014 test-aid-test-audit-dispatch.bats caught it.",
      "if": {
        "properties": {
          "focus": {
            "const": "shard_portfolio"
          }
        }
      },
      "then": {
        "properties": {
          "shard_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "shard_id": {
            "type": "null"
          }
        }
      }
    }
  ]
}

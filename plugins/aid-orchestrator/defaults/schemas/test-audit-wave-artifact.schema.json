{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aid-orchestrator.aidlab.dev/schemas/test-audit-wave-artifact.schema.json",
  "title": "AID Test Portfolio Audit — Per-Wave Agent Artifact",
  "$comment": "producer: controller (one file per dispatched shard/specialist agent, per aid-test-audit-dispatch.sh's manifest), consumers: [aid-test-audit-consolidate.sh, aid-test-audit-state.sh advance_wave validation]",
  "description": "Raw output of one wave-1/2/3 agent, written to .aid-o/work/test-audits/<audit-id>/agents/<wave>-<focus>[-<shard_id>].json before consolidation. advance_wave halts rather than silently advancing if a wave artifact fails this schema.",
  "type": "object",
  "required": [
    "schema_version",
    "focus",
    "wave",
    "shard_id",
    "findings",
    "produced_at",
    "producer_agent_dispatch_id"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "focus": {
      "type": "string",
      "enum": [
        "shard_portfolio",
        "performance_cost",
        "flake_isolation",
        "parallel_safety",
        "adversarial_review",
        "consolidator"
      ]
    },
    "wave": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "shard_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Only shard_portfolio-focus artifacts are sharded; null for all other focuses."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "run_unit_id",
          "category",
          "severity",
          "evidence_refs",
          "recommendation",
          "confidence",
          "falsification_check"
        ],
        "properties": {
          "run_unit_id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommendation": {
            "type": "string",
            "enum": [
              "keep",
              "fix",
              "split",
              "merge",
              "remove",
              "quarantine",
              "measure"
            ]
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "falsification_check": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer_agent_dispatch_id": {
      "type": "string",
      "minLength": 1
    },
    "dispositions": {
      "type": "array",
      "description": "P072 Step 4 — exactly one TERMINAL disposition per run_unit_id this shard was assigned, including when the answer is `keep`. Silence cannot distinguish 'healthy and uniquely useful' from 'never inspected', so a shard that inspected nothing must say `measure` with a named missing_proof rather than emitting no record. Presence is enforced by aid-test-audit-consolidate.sh --mode full, not by this schema: the schema has no view of the audit mode, and a static/measure audit legitimately produces no dispositions. What this schema guarantees is that a disposition, WHEN present, is complete.",
      "items": {
        "type": "object",
        "required": [
          "run_unit_id",
          "disposition",
          "behavior_claim",
          "failure_signal",
          "falsification",
          "uniqueness",
          "layer",
          "cheaper_layer_possible",
          "cost",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "run_unit_id": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "enum": [
              "keep",
              "fix",
              "rewrite_unit",
              "merge",
              "split",
              "remove",
              "quarantine",
              "keep_serial",
              "parallelize",
              "measure"
            ]
          },
          "behavior_claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "The invariant or historical regression this unit claims to protect."
          },
          "failure_signal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "The concrete signal the test emits when that behavior breaks."
          },
          "falsification": {
            "type": "object",
            "required": [
              "method"
            ],
            "additionalProperties": false,
            "properties": {
              "method": {
                "enum": [
                  "mutation",
                  "revert",
                  "input_probe",
                  "unproved"
                ]
              },
              "evidence_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
                "description": "Audit-relative path. Anchored to a non-'/' first character so an absolute path cannot be recorded; the consolidator additionally resolves it and refuses anything that escapes the audit directory."
              }
            },
            "allOf": [
              {
                "$comment": "Anything other than `unproved` is a claim that a check was actually run, so it must cite where.",
                "if": {
                  "properties": {
                    "method": {
                      "enum": [
                        "mutation",
                        "revert",
                        "input_probe"
                      ]
                    }
                  },
                  "required": [
                    "method"
                  ]
                },
                "then": {
                  "required": [
                    "evidence_ref"
                  ]
                }
              }
            ]
          },
          "uniqueness": {
            "enum": [
              "unique",
              "overlaps",
              "unproved"
            ]
          },
          "overlaps_with": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "layer": {
            "enum": [
              "unit",
              "contract",
              "integration",
              "e2e"
            ]
          },
          "cheaper_layer_possible": {
            "enum": [
              "yes",
              "no",
              "unproved"
            ]
          },
          "target_layer": {
            "enum": [
              "unit",
              "contract",
              "integration",
              "e2e"
            ]
          },
          "cost": {
            "type": "object",
            "required": [
              "kind",
              "duration_ms"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": [
                  "measured",
                  "lower_bound",
                  "unknown"
                ]
              },
              "duration_ms": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "unknown"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "properties": {
                    "duration_ms": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "measured",
                        "lower_bound"
                      ]
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "then": {
                  "properties": {
                    "duration_ms": {
                      "type": "integer"
                    }
                  }
                }
              }
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "missing_proof": {
            "enum": [
              "empty_inventory",
              "coverage_mismatch",
              "duplicate_dispositions",
              "unresolved_fraction_exceeded",
              "budget_exhausted",
              "interrupted",
              "no_resource_map",
              "no_pilot_evidence",
              "runner_capability_absent",
              "template_context_required",
              "source_unreadable"
            ],
            "description": "Required when disposition is `measure` — a controlled reason, never free text."
          },
          "next_measurement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Required when disposition is `measure` — names a bounded operation this plugin can actually run."
          }
        },
        "allOf": [
          {
            "$comment": "A coverage-REDUCING proposal must name which retained test still catches the defect. `unproved` is not an argument for deletion.",
            "if": {
              "properties": {
                "disposition": {
                  "enum": [
                    "remove",
                    "merge",
                    "rewrite_unit"
                  ]
                }
              },
              "required": [
                "disposition"
              ]
            },
            "then": {
              "properties": {
                "falsification": {
                  "properties": {
                    "method": {
                      "enum": [
                        "mutation",
                        "revert",
                        "input_probe"
                      ]
                    }
                  },
                  "required": [
                    "evidence_ref"
                  ]
                }
              }
            }
          },
          {
            "$comment": "Claiming overlap without naming the peer is not a claim a reader can check.",
            "if": {
              "properties": {
                "uniqueness": {
                  "const": "overlaps"
                }
              },
              "required": [
                "uniqueness"
              ]
            },
            "then": {
              "required": [
                "overlaps_with"
              ],
              "properties": {
                "overlaps_with": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "$comment": "'a cheaper layer would do' is only actionable when it names which layer.",
            "if": {
              "properties": {
                "cheaper_layer_possible": {
                  "const": "yes"
                }
              },
              "required": [
                "cheaper_layer_possible"
              ]
            },
            "then": {
              "required": [
                "target_layer"
              ]
            }
          },
          {
            "$comment": "`measure` is the honest 'I did not settle this' answer, but it must say what is missing and what would settle it.",
            "if": {
              "properties": {
                "disposition": {
                  "const": "measure"
                }
              },
              "required": [
                "disposition"
              ]
            },
            "then": {
              "required": [
                "missing_proof",
                "next_measurement"
              ]
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}

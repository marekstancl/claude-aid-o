{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aid-orchestrator.aidlab.dev/schemas/plan-graph.schema.json",
  "title": "AID Protocol v2 — PlanGraph",
  "$comment": "producer: C0, consumers: [C0, C4]",
  "description": "Artifact emitted by C0 containing the dependency graph of the plan, including topological ordering and cycle detection results.",
  "type": "object",
  "allOf": [
    {
      "$comment": "extends aid-protocol-v2.schema.json envelope (reference only — not a resolved $ref)"
    }
  ],
  "properties": {
    "artifact_type": {
      "const": "plan_graph",
      "$comment": "enforced — must equal this type"
    },
    "plan_graph": {
      "type": "object",
      "$comment": "required: edges, topological_order, cycles",
      "properties": {
        "edges": {
          "type": "array",
          "items": { "type": "object" }
        },
        "topological_order": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cycles": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["edges", "topological_order", "cycles"]
    }
  },
  "required": ["plan_graph"]
}

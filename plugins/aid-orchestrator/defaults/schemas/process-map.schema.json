{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aid-orchestrator.aidlab.dev/schemas/process-map.schema.json",
  "title": "Procesní mapa (docs/procesy/<jméno>.mapa.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "nazev",
    "druh",
    "stav",
    "puvod",
    "kroky",
    "prechody"
  ],
  "properties": {
    "nazev": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "druh": {
      "enum": [
        "bpmn",
        "stav"
      ]
    },
    "stav": {
      "enum": [
        "dnes",
        "po",
        "schvaleno"
      ]
    },
    "puvod": {
      "enum": [
        "kod",
        "rozhovor"
      ]
    },
    "zdroj": {
      "$ref": "#/$defs/codePlace"
    },
    "kroky": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "jmeno",
          "co"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/stepId"
          },
          "jmeno": {
            "type": "string",
            "minLength": 1,
            "maxLength": 36
          },
          "co": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "konec": {
            "enum": [
              "none",
              "ok",
              "bad"
            ],
            "default": "none"
          },
          "kod": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/codePlace"
            }
          },
          "ceka": {
            "type": "boolean",
            "default": false,
            "description": "the step waits for a person (role pm)"
          }
        }
      }
    },
    "prechody": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "z",
          "do"
        ],
        "properties": {
          "z": {
            "$ref": "#/$defs/stepId"
          },
          "do": {
            "$ref": "#/$defs/stepId"
          },
          "popis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          }
        }
      }
    },
    "odevsad": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "do",
          "popis"
        ],
        "properties": {
          "do": {
            "$ref": "#/$defs/stepId"
          },
          "popis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "vcetne_koncu": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "otazky": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cil",
          "text",
          "stav"
        ],
        "properties": {
          "cil": {
            "$ref": "#/$defs/stepId"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "stav": {
            "enum": [
              "neovereno",
              "overeno",
              "zamitnuto"
            ]
          }
        }
      }
    },
    "proti": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+\\.mapa\\.yaml$"
    }
  },
  "$defs": {
    "stepId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "codePlace": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/@+-]+(:[0-9]+)?$"
    }
  },
  "if": {
    "properties": {
      "puvod": {
        "const": "kod"
      }
    }
  },
  "then": {
    "required": [
      "zdroj"
    ]
  }
}

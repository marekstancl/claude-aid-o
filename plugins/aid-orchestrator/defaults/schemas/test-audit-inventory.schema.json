{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aid-orchestrator.aidlab.dev/schemas/test-audit-inventory.schema.json",
  "title": "AID Test Portfolio Audit — Wave-0 Scanner Inventory",
  "$comment": "producer: aid-test-inventory.sh, consumers: [aid-test-audit-dispatch.sh, aid-test-catalog-selector-snapshot.sh]",
  "description": "Deterministic, zero-LLM-dispatch scanner output. One entry per adapter-discovered run_unit, with provenance. This is a discovery record, not the catalog itself (aid-test-inventory.sh separately emits test-catalog.proposed.yaml from the same scan).",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "runner_families",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "runner_families": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "run_unit_id",
          "runner",
          "adapter",
          "confidence"
        ],
        "properties": {
          "run_unit_id": {
            "type": "string",
            "minLength": 1
          },
          "runner": {
            "type": "string",
            "minLength": 1
          },
          "adapter": {
            "type": "string",
            "enum": [
              "bats",
              "sh",
              "package-script",
              "declared-command"
            ],
            "$comment": "P072 Step 7 — `sh` is the standalone-shell-suite adapter. Without it here, discovered shell suites fail inventory validation and the whole audit refuses to publish."
          },
          "confidence": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "isolation": {
            "type": "object",
            "properties": {
              "lock_usage": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "lock_target",
                    "resolved_scope"
                  ],
                  "properties": {
                    "lock_target": {
                      "type": "string"
                    },
                    "resolved_scope": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "reconciliation": {
      "type": "object",
      "description": "P072 Step 10 — how the adapters' outputs add up. Present so a reader can check the portfolio's own arithmetic instead of trusting it.",
      "additionalProperties": false,
      "required": [
        "per_runner_counts",
        "total_run_units",
        "files_seen",
        "overlaps",
        "contains"
      ],
      "properties": {
        "per_runner_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "total_run_units": {
          "type": "integer",
          "minimum": 0
        },
        "files_seen": {
          "type": "integer",
          "minimum": 0,
          "description": "Distinct TEST-file paths. Excludes declared-command units, whose source_paths names the file that declares the gate rather than a test."
        },
        "overlaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "ids",
              "runners"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "runners": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "contains": {
          "type": "array",
          "description": "Which run units each declared gate actually dispatches, derived from its command.argv — NOT from its source_paths. This is what lets a double-execution check tell a legitimate membership apart from the same unit being reached by two independent gates.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gate",
              "kind",
              "partition",
              "membership",
              "run_unit_ids"
            ],
            "properties": {
              "gate": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "aggregate_runner",
                  "catalog_pool_runner",
                  "direct_invocation",
                  "context_required"
                ]
              },
              "run_unit_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "partition": {
                "enum": [
                  "pool",
                  "dedicated",
                  "all"
                ],
                "description": "Which slice of its candidate set the gate dispatches. `--pool-only` and `--dedicated-only` are complementary, so the two lane gates do not overlap despite sharing a candidate set."
              },
              "membership": {
                "enum": [
                  "exact",
                  "runtime_partitioned"
                ],
                "description": "`exact` — run_unit_ids is what this gate runs. `runtime_partitioned` — it is the CANDIDATE set; the real membership is decided at dispatch time, so treating it as exact produces false double-execution reports."
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aid-orchestrator.aidlab.dev/schemas/plan-review.schema.json",
  "title": "AID Protocol v2 — PlanReview",
  "$comment": "producer: C0, consumers: [C2, C3, C4]",
  "description": "Artifact emitted by C0 (plan verifier) after reviewing the plan structure, completeness, and boundary integrity.",
  "type": "object",
  "allOf": [
    {
      "$comment": "extends aid-protocol-v2.schema.json envelope (reference only — not a resolved $ref)"
    }
  ],
  "properties": {
    "artifact_type": {
      "const": "plan_review",
      "$comment": "enforced — must equal this type"
    },
    "plan_review": {
      "type": "object",
      "$comment": "enforced — minimal payload; structural_checks/lens_findings/findings are OPTIONAL for C4 backward-compat",
      "properties": {
        "plan_id": {
          "type": "string"
        },
        "review_outcome": {
          "type": "string"
        },
        "structural_issues": {
          "type": "array",
          "$comment": "legacy field — pre-E4 plans may use this"
        },
        "structural_checks": {
          "type": "array",
          "$comment": "optional — added in E4",
          "items": {
            "type": "object",
            "properties": {
              "id":     { "type": "string" },
              "status": { "type": "string", "enum": ["pass", "observe", "unverifiable", "fail"] },
              "detail": { "type": "string" }
            }
          }
        },
        "lens_findings": {
          "type": "array",
          "$comment": "optional — added in E4",
          "items": {
            "type": "object",
            "properties": {
              "lens":    { "type": "string" },
              "verdict": { "type": "string", "enum": ["found", "clean", "absent"] },
              "count":   { "type": "integer" }
            }
          }
        },
        "lens_dispatch_observed": {
          "type": "string",
          "$comment": "optional — format: '{found}/5', e.g. '3/5'"
        },
        "findings": {
          "type": "array",
          "$comment": "optional — aggregated findings from all checks/lenses"
        }
      }
    }
  },
  "required": ["plan_review"]
}

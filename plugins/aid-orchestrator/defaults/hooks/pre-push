#!/usr/bin/env bash
# AID-ORCHESTRATOR-PREPUSH-START (do not edit this block manually)
# AID Orchestrator — version bump check before push
# Blocks push if feat:/fix: commits exist since last tag without version bump.
#
# This hook reads NO `.aid-o` paths — it works purely from git refs/tags/log,
# worktree-safe by construction. It fires from every linked worktree (hooks
# live in the COMMON .git/hooks), where `$PWD`-relative `.aid-o` reads would
# MISS, so any `.aid-o` read added here must resolve the state root first —
# copy the `_aid_state_root` helper from the pre-commit hook.

# ── P068 E-068-1_2 Step 5: plan/* and task/* are EXEMPT ─────────────────────
# This guard blocks any push carrying feat:/fix: commits since the last tag with
# no release: commit among them. In `plan_branch` mode a plan branch accumulates
# exactly that from its first EPIC until the plan-final freeze, so without this
# exemption EVERY push of a task/* or plan/* branch would be blocked — and the
# remedy the hook prints (`aid-release.sh auto`) is the per-EPIC release ceremony
# P068 exists to remove. The guard stays FULLY ACTIVE for the target branch,
# which under the new model is the only branch where a premature release is
# possible: it is moved once, by plan-merge-to-main, after the PM authorizes it.
#
# The refs being pushed are read from stdin (git's pre-push protocol:
# "<local ref> <local sha> <remote ref> <remote sha>" per line). A `(delete)`
# local ref carries no commits and is skipped. Only if EVERY pushed ref is a
# plan/* or task/* branch is the push exempt — a push that also carries the
# target branch is still checked. When stdin is empty (the hook invoked by hand,
# or a git that supplies no refs) we fall back to the current branch name, so the
# exemption is never silently unreachable.
#
# P089 Step 8 also records the ref/sha PAIRS. The range this hook judges ends at
# the LOCAL SHA git names on the protocol line, not at HEAD: `git push origin
# HEAD~2:main` pushes something HEAD is not, and judging HEAD would have blamed
# work that is not being pushed at all.
_AID_PUSH_REFS=""
_AID_PUSH_PAIRS=""
if [ ! -t 0 ]; then
  while read -r _lref _lsha _rref _rsha; do
    [ -n "${_lref:-}" ] || continue
    if [ -n "${_lsha:-}" ]; then
      _AID_PUSH_PAIRS="${_AID_PUSH_PAIRS}${_rref:-$_lref}|${_lsha}
"
    fi
    # CP2 M4 (2026-07-26): record BOTH sides of the refspec. Matching only the
    # LOCAL ref let `git push origin plan/P068:main` slip the target branch
    # through — the local ref is plan/* and therefore "exempt", while what
    # actually lands on the remote is main, unguarded. What the guard protects is
    # decided by the REMOTE ref, so both must be exempt for the push to be exempt.
    _AID_PUSH_REFS="${_AID_PUSH_REFS}${_lref}
"
    [ -n "${_rref:-}" ] && _AID_PUSH_REFS="${_AID_PUSH_REFS}${_rref}
"
  done
fi
if [ -z "$_AID_PUSH_REFS" ]; then
  _AID_PUSH_REFS="$(git symbolic-ref -q HEAD 2>/dev/null || true)"
fi
if [ -z "$_AID_PUSH_PAIRS" ]; then
  _AID_PUSH_PAIRS="$(git symbolic-ref -q HEAD 2>/dev/null || printf 'HEAD')|$(git rev-parse HEAD 2>/dev/null || printf 'HEAD')"
fi

if [ -n "$_AID_PUSH_REFS" ]; then
  _AID_ALL_EXEMPT=true
  _AID_SAW_REF=false
  while IFS= read -r _ref; do
    [ -n "$_ref" ] || continue
    [ "$_ref" = "(delete)" ] && continue
    _AID_SAW_REF=true
    case "$_ref" in
      refs/heads/plan/*|refs/heads/task/*|plan/*|task/*) ;;
      *) _AID_ALL_EXEMPT=false ;;
    esac
  done <<EOF
$_AID_PUSH_REFS
EOF
  if [ "$_AID_SAW_REF" = "true" ] && [ "$_AID_ALL_EXEMPT" = "true" ]; then
    # plan/* and task/* only — the version-bump guard does not apply.
    exit 0
  fi
fi

# AID-RELEASE-SCOPE-PORTABLE-START
# Everything between these markers is COPIED VERBATIM into
# defaults/hooks/pre-push, which cannot source this file: it runs inside the
# consumer's repository, where the plugin cache is not on any path it knows.
# Two copies of a decision are how two answers start; the copy is therefore
# byte-compared by test-release-scope.bats, and that test is written first.
#
# Nothing in this region may source another library or read a `.aid-o` path
# through a helper that lives outside it.

# _aid_rs_match <path> <newline-separated globs>
#   Exact path or directory-prefix match — the same shape defaults/hooks/pre-commit
#   already uses for its staged-file scope, so one idea of "is this path in the
#   list" exists in the plugin rather than two.
_aid_rs_match() {
  local _f="$1" _s
  while IFS= read -r _s; do
    [[ -z "$_s" ]] && continue
    [[ "$_f" == "$_s" || "$_f" == "$_s"/* ]] && return 0
  done <<< "$2"
  return 1
}

# _aid_rs_cfg <root> <key> — one list from .aid-o/config/project.yaml's
# `versioning` section, one entry per line. Exit 1 when it cannot be read at
# all: that is the fail-open signal, not an empty list.
_aid_rs_cfg() {
  local root="$1" key="$2" out=""
  command -v yq >/dev/null 2>&1 || return 1
  local cfg="${root%/}/.aid-o/config/project.yaml"
  [[ -f "$cfg" ]] || return 1
  # `.a[]?` alone, never `// empty`: mikefarah yq has no jq `empty`, and the
  # expression it cannot lex makes the whole read fail — which fails OPEN, so
  # a configured project would have silently kept the old label behaviour.
  out="$(yq -r ".versioning.${key}[]?" "$cfg" 2>/dev/null)" || return 1
  [[ -n "$out" ]] || return 1
  printf '%s' "$out"
}

# _aid_rs_commits <root> <start> <end>
#   The commits in the range MINUS the ones carrying a `No-Release:` footer.
#   The footer's value must be non-empty: the point is an auditable reason, and
#   a bare `No-Release:` is a switch, not a reason.
_aid_rs_commits() {
  local root="$1" start="$2" end="$3" sha
  while IFS= read -r sha; do
    [[ -n "$sha" ]] || continue
    if git -C "$root" log -1 --format=%B "$sha" 2>/dev/null \
       | grep -qE '^No-Release:[[:space:]]*[^[:space:]]'; then
      continue
    fi
    printf '%s\n' "$sha"
  done < <(git -C "$root" rev-list "${start}..${end}" 2>/dev/null)
}

# _aid_rs_paths <root> <sha…> — the UNION of the paths those commits touched.
_aid_rs_paths() {
  local root="$1"; shift
  local sha
  for sha in "$@"; do
    git -C "$root" show --name-only --no-renames --first-parent -m --format='' "$sha" 2>/dev/null
  done | sed '/^$/d' | sort -u
}

# aid_release_scope_start <root> [rev]
#   The last version tag REACHABLE FROM <rev> — a verifiable statement about
#   what was released at that point. Nothing (exit 1) when the repository has
#   never been tagged.
#
#   `[rev]` is not decoration. `git describe` with no revision answers about
#   HEAD, and a pre-push hook judging `git push origin B:main` asks about B.
#   With a later tag on HEAD, HEAD's tag is not an ancestor of B, so `tag..B`
#   came out EMPTY and the push passed — the range has to be measured from the
#   commit actually being pushed.
aid_release_scope_start() {
  local root="$1" rev="${2:-HEAD}" tag
  tag="$(git -C "$root" describe --tags --abbrev=0 "$rev" 2>/dev/null)" || tag=""
  [[ -n "$tag" ]] || return 1
  printf '%s' "$tag"
}

# aid_release_scope_evaluate <root> <start> <end>
#   Fills three globals and returns 0. Split from the printers so the report
#   and the one-word verdict cannot disagree by being computed twice.
#     _AID_RS_VERDICT    no_config | no_commits | exempt | release_required
#     _AID_RS_CULPRITS   "<sha> <subject>" lines that put a path in scope
#     _AID_RS_WARNINGS   lines that never block
aid_release_scope_evaluate() {
  local root="$1" start="$2" end="$3"
  _AID_RS_VERDICT=""; _AID_RS_CULPRITS=""; _AID_RS_WARNINGS=""

  # NEVER RELEASED IS ITS OWN ANSWER. An empty `start` used to mean the root of
  # history, and `root..HEAD` EXCLUDES the root commit — so a repository whose
  # single commit was the whole application reported "no commits" and passed.
  # An untagged repository is waved through (the inherited direction, and a
  # first push should not demand a release), but it is now waved through
  # EXPLICITLY, with a verdict a caller can print.
  if [[ -z "$start" ]]; then
    _AID_RS_VERDICT="no_tag"
    _AID_RS_WARNINGS="this repository has no version tag, so there is no released state to compare against; the release guard passes and will start deciding after the first tag."
    return 0
  fi

  local exempt app
  if ! exempt="$(_aid_rs_cfg "$root" release_exempt_paths)"; then
    _AID_RS_VERDICT="no_config"
    _AID_RS_WARNINGS="versioning.release_exempt_paths is not set in .aid-o/config/project.yaml (or yq is unavailable), so the release guard is deciding by commit label as it did before. Run /aid-setup to fill it in."
    return 0
  fi
  app="$(_aid_rs_cfg "$root" app_paths)" || app=""

  local -a shas=()
  local sha
  while IFS= read -r sha; do [[ -n "$sha" ]] && shas+=("$sha"); done < <(_aid_rs_commits "$root" "$start" "$end")
  if (( ${#shas[@]} == 0 )); then
    _AID_RS_VERDICT="no_commits"
    return 0
  fi

  local paths outside="" p
  paths="$(_aid_rs_paths "$root" "${shas[@]}")"
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    _aid_rs_match "$p" "$exempt" || outside+="${p}"$'\n'
  done <<< "$paths"

  if [[ -z "$outside" ]]; then
    _AID_RS_VERDICT="exempt"
  else
    _AID_RS_VERDICT="release_required"
    # WHO caused it: the commits that touched at least one path outside the
    # exempt list. A refusal that only says "something" is a refusal nobody can act on.
    local subj cp
    for sha in "${shas[@]}"; do
      while IFS= read -r cp; do
        [[ -n "$cp" ]] || continue
        if grep -qxF "$cp" <<< "$outside"; then
          subj="$(git -C "$root" log -1 --format=%s "$sha" 2>/dev/null)"
          _AID_RS_CULPRITS+="${sha:0:8} ${subj}"$'\n'
          break
        fi
      done < <(git -C "$root" show --name-only --no-renames --first-parent -m --format='' "$sha" 2>/dev/null)
    done
  fi

  # Warnings never block. The label is kept for exactly this: telling the PM
  # that a commit calling itself housekeeping touched the application.
  if [[ -n "$app" ]]; then
    # The pattern is a VARIABLE, not a literal: an unquoted `(` inside a
    # bracket expression makes bash's `[[ ]]` parser read it as a subshell.
    local msubj mp
    local housekeeping='^(chore|docs|test|style|ci)[(:]'
    for sha in "${shas[@]}"; do
      msubj="$(git -C "$root" log -1 --format=%s "$sha" 2>/dev/null)"
      [[ "$msubj" =~ $housekeeping ]] || continue
      while IFS= read -r mp; do
        [[ -n "$mp" ]] || continue
        if _aid_rs_match "$mp" "$app"; then
          _AID_RS_WARNINGS+="${sha:0:8} calls itself housekeeping (\"${msubj}\") but touched ${mp}"$'\n'
          break
        fi
      done < <(git -C "$root" show --name-only --no-renames --first-parent -m --format='' "$sha" 2>/dev/null)
    done
  fi
  return 0
}

# aid_release_scope_verdict <root> <start> <end> — the one word.
aid_release_scope_verdict() {
  aid_release_scope_evaluate "$@" || return 1
  printf '%s\n' "$_AID_RS_VERDICT"
}

# aid_release_scope_report <root> <start> <end> — the verdict plus the reasons.
aid_release_scope_report() {
  aid_release_scope_evaluate "$@" || return 1
  printf 'verdict: %s\n' "$_AID_RS_VERDICT"
  local l
  while IFS= read -r l; do [[ -n "$l" ]] && printf 'commit: %s\n' "$l"; done <<< "$_AID_RS_CULPRITS"
  while IFS= read -r l; do [[ -n "$l" ]] && printf 'warn: %s\n' "$l"; done <<< "$_AID_RS_WARNINGS"
  return 0
}
# AID-RELEASE-SCOPE-PORTABLE-END

# ── the decision, per pushed ref ───────────────────────────────────────────
# EVERY REF IS JUDGED ON ITS OWN. A push may carry several, and one of them
# being exempt says nothing about the next. The end of the range is the ref's
# own LOCAL SHA from the protocol line — not HEAD, which is a different commit
# whenever `git push origin HEAD~2:main` is what was actually asked for.
# THE STATE ROOT, NOT THE WORKTREE TOP. `.aid-o` exists only in the primary
# checkout, so `--show-toplevel` from a linked worktree finds no config and the
# guard would quietly drop to the old label branch there. The objects are shared,
# so running git against the primary root judges the pushed sha correctly. Same
# tiny copy of the resolver defaults/hooks/pre-commit carries, and the same
# fallback: if git cannot answer, use the worktree top, which is never worse
# than the pre-P089 behaviour.
_aid_prepush_state_root() {
  local _common _root
  _common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
  _root="${_common%/.git}"
  [ -n "$_root" ] && [ -d "$_root/.aid-o" ] || _root="$(git rev-parse --show-toplevel 2>/dev/null || printf '.')"
  printf '%s' "$_root"
}
_AID_REPO_ROOT="$(_aid_prepush_state_root)"

_aid_prepush_label_fallback() {
  # NO CONFIG: exactly the check this hook made before P089, kept whole. A
  # project must not start failing because it has not been configured yet.
  local _commits _has=false _line _msg
  local _start="${2:-}"
  [ -n "$_start" ] || return 0
  _commits="$(git -C "$_AID_REPO_ROOT" log "${_start}..${1}" --oneline --no-merges 2>/dev/null || true)"
  [ -n "$_commits" ] || return 0
  while IFS= read -r _line; do
    _msg="${_line#* }"
    case "$_msg" in
      release:*) return 0 ;;
      feat*|fix*) _has=true ;;
    esac
  done <<EOF
$_commits
EOF
  [ "$_has" = "true" ] || return 0
  echo "" >&2
  echo "AID HOOK: Push blocked — commits since ${_start} without a version bump." >&2
  echo "  Run: bash plugins/aid-orchestrator/scripts/aid-release.sh auto" >&2
  echo "  Or push without bump: git push --no-verify" >&2
  echo "" >&2
  return 1
}

_AID_BLOCKED=0
while IFS= read -r _entry; do
  [ -n "$_entry" ] || continue
  _AID_REF="${_entry%%|*}"
  _AID_SHA="${_entry#*|}"
  [ "$_AID_SHA" = "0000000000000000000000000000000000000000" ] && continue
  case "$_AID_REF" in
    refs/heads/plan/*|refs/heads/task/*|plan/*|task/*) continue ;;
  esac

  # THE START IS MEASURED FROM THE SHA BEING PUSHED, not from HEAD: with a
  # later tag on HEAD, HEAD's tag is not an ancestor of an older pushed commit
  # and the range came out empty, so the push passed unjudged.
  _AID_START="$(aid_release_scope_start "$_AID_REPO_ROOT" "$_AID_SHA")" || _AID_START=""
  aid_release_scope_evaluate "$_AID_REPO_ROOT" "$_AID_START" "$_AID_SHA"

  # Warnings go out whatever the verdict, and never block on their own.
  while IFS= read -r _w; do
    [ -n "$_w" ] || continue
    echo "AID HOOK: warning — $_w" >&2
  done <<EOF
$_AID_RS_WARNINGS
EOF

  case "$_AID_RS_VERDICT" in
    no_config)
      _aid_prepush_label_fallback "$_AID_SHA" "$_AID_START" || _AID_BLOCKED=1
      ;;
    no_tag|no_commits|exempt) ;;
    release_required)
      echo "" >&2
      echo "AID HOOK: Push of ${_AID_REF} blocked — it changes code outside the release-exempt paths and no version was released." >&2
      echo "" >&2
      while IFS= read -r _c; do
        [ -n "$_c" ] || continue
        echo "  $_c" >&2
      done <<EOF
$_AID_RS_CULPRITS
EOF
      echo "" >&2
      echo "  Release it:  bash plugins/aid-orchestrator/scripts/aid-release.sh auto" >&2
      echo "  Or exempt a single commit deliberately, with a reason that stays in the history:" >&2
      echo "    git commit --amend -m \"<subject>\" -m \"No-Release: <why this ships nothing>\"" >&2
      echo "  Or push without any of this: git push --no-verify" >&2
      echo "" >&2
      _AID_BLOCKED=1
      ;;
  esac
done <<EOF
$_AID_PUSH_PAIRS
EOF

[ "$_AID_BLOCKED" = "1" ] && exit 1
exit 0
# AID-ORCHESTRATOR-PREPUSH-END
exit 0

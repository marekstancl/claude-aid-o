#!/usr/bin/env bash
# AID-ORCHESTRATOR-HOOK-START (do not edit this block manually)
# AID Orchestrator — FSM guard pre-commit hook
# Blocks commits on FSM-managed branches when DONE state review is incomplete.

_AID_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || true)

if [[ "$_AID_BRANCH" == task/* || "$_AID_BRANCH" == epic/* ]]; then

  # Extract epic/task ID from branch name for targeted fsm-state.yaml lookup
  _AID_BRANCH_ID=$(echo "$_AID_BRANCH" | cut -d'/' -f2)
  _AID_STATE_FILE=""

  # Find state.yaml or fsm-state.yaml matching the branch ID (search runs/ + evidence/)
  for _AID_SEARCH_DIR in ".aid-o/work/runs/" ".aid-o/work/evidence/"; do
    [[ -d "$_AID_SEARCH_DIR" ]] || continue
    while IFS= read -r _f; do
      if grep -q "epic_id: ${_AID_BRANCH_ID}" "$_f" 2>/dev/null; then
        _AID_STATE_FILE="$_f"
        break 2
      fi
    done < <(find "$_AID_SEARCH_DIR" \( -name "state.yaml" -o -name "fsm-state.yaml" \) 2>/dev/null)
  done

  if [[ -n "$_AID_STATE_FILE" ]]; then
    _AID_FSM_STATE=$(grep '^state:' "$_AID_STATE_FILE" | awk '{print $2}')
    _AID_DONE_PHASE=$(grep '^done_phase:' "$_AID_STATE_FILE" | awk '{print $2}')

    if [[ "$_AID_FSM_STATE" == "DONE" && "$_AID_DONE_PHASE" != "release" ]]; then
      echo "AID HOOK: Commit blocked — FSM is in DONE/${_AID_DONE_PHASE:-review}." >&2
      echo "Run Curator + Auditor, then: aid-fsm.sh done-advance review release" >&2
      exit 1
    fi

    if [[ "$_AID_FSM_STATE" == "READY" ]]; then
      echo "AID HOOK: Commit blocked — FSM is in READY (not yet executing)." >&2
      exit 1
    fi
  fi

fi
# AID-ORCHESTRATOR-HOOK-END

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hodnocení kritika (P113a)",
  "type": "object",
  "required": [
    "criteria",
    "findings",
    "readiness",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "score",
          "anchor",
          "evidence",
          "missing_for_next"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "score": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 10
          },
          "anchor": {
            "type": [
              "integer",
              "null"
            ],
            "enum": [
              4,
              6,
              8,
              10,
              null
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 10
          },
          "missing_for_next": {
            "type": "string",
            "minLength": 3
          },
          "not_assessable": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "score": {
                  "type": "null"
                }
              }
            },
            "then": {
              "required": [
                "not_assessable"
              ],
              "properties": {
                "anchor": {
                  "type": "null"
                },
                "not_assessable": {
                  "type": "string",
                  "minLength": 5
                }
              }
            },
            "else": {
              "not": {
                "required": [
                  "not_assessable"
                ]
              }
            }
          }
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "criterion",
          "severity",
          "owner",
          "text",
          "fix",
          "where"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "criterion": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "blocking",
              "major",
              "minor"
            ]
          },
          "owner": {
            "enum": [
              "agent",
              "client"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 5
          },
          "fix": {
            "type": "string",
            "minLength": 5
          },
          "where": {
            "type": "string",
            "minLength": 3
          },
          "regression_of": {
            "type": "string",
            "minLength": 1,
            "description": "id nálezu z historie (podklady/historie.json), který byl vyřešen nebo zamítnut a znovu ho vidíš; jen s novým důkazem v text"
          }
        }
      }
    },
    "readiness": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item"
        ],
        "additionalProperties": false,
        "properties": {
          "item": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 10
    }
  }
}
